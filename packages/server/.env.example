# Neon serverless Postgres (Vercel Marketplace → copy the connection string,
# or `vercel env pull` it into a gitignored .env*.local at the repo root)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Better Auth — generate a strong random secret (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# The app origin Better Auth issues cookies for.
#   dev:  http://localhost:5173   prod: https://<your-domain>
BETTER_AUTH_URL=http://localhost:5173

# Lock email/password sign-up to specific addresses (comma-separated). Strongly
# recommended on the public deployment so only you can register. Leave empty to
# allow anyone (fine for local dev).
AUTH_ALLOWED_EMAILS=

# Segue planner (optional — without it the planner falls back to a heuristic)
ANTHROPIC_API_KEY=

# Dev-only CORS origin for the GraphQL/auth server (defaults to the Vite dev origin)
WEB_ORIGIN=http://localhost:5173
