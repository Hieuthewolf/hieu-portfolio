{
  "name": "@portfolio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "print-schema": "tsx src/print-schema.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.83",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^6.0.208",
    "better-auth": "^1.6.19",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.6.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
