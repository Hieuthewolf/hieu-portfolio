{
  "name": "hieu-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "relay": "pnpm --filter @portfolio/server print-schema && pnpm --filter @portfolio/web relay",
    "vercel-build": "pnpm --filter @portfolio/server build && if [ -n \"$DATABASE_URL\" ]; then pnpm --filter @portfolio/server db:migrate; else echo 'No DATABASE_URL — skipping migrations'; fi && pnpm --filter @portfolio/server print-schema && pnpm --filter @portfolio/web run relay && pnpm --filter @portfolio/web build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.19",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  }
}
